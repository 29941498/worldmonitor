FROM node:24-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43

RUN apk add --no-cache nginx && \
    mkdir -p /run/nginx /var/lib/nginx/tmp/client_body /var/lib/nginx/tmp/proxy && \
    chown -R node:node /run/nginx /var/lib/nginx /var/log/nginx

COPY deploy/self-hosted/nginx/auth-proxy.conf /etc/nginx/nginx.conf.template
COPY deploy/self-hosted/scripts/auth-proxy-entrypoint.sh /usr/local/bin/auth-proxy-entrypoint

USER node
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz >/dev/null 2>&1 || exit 1

ENTRYPOINT ["/usr/local/bin/auth-proxy-entrypoint"]
