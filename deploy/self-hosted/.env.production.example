# Copy to .env.production, chmod 600, and replace every required placeholder.
# deploy.sh derives the immutable image tag from worldmonitor-<git-sha> release
# directory names. For a non-release checkout, export WM_IMAGE_TAG explicitly.
WM_LOCAL_HEALTH_PORT=18100
WM_RUNTIME_UID=1000
WM_RUNTIME_GID=1000

# Used only with docker-compose.domain.yml. Keep the default loopback binding
# unless a trusted reverse proxy reaches this host through a private interface.
WM_AUTH_BIND_IP=127.0.0.1
WM_AUTH_PORT=18101

# Used only with docker-compose.egress.yml. The proxy image and JSON config
# are host-provisioned runtime inputs; never commit the config or credentials.
WM_EGRESS_PROXY_IMAGE=worldmonitor/egress-proxy:xray-25.8.3
WM_EGRESS_PROXY_CONFIG=./shared/egress/xray-config.json
WM_EGRESS_PROXY_URL=http://egress-proxy:10808
WM_EGRESS_NO_PROXY=redis,redis-rest,ais-relay,auth-proxy,worldmonitor,egress-proxy,localhost,127.0.0.1

# Pinned cloudflared download inputs. Container base images are pinned directly
# in Dockerfiles and Compose so environment overrides cannot weaken them.
# Set this only on a host that cannot reach Docker Hub. The deployment script
# accepts only a local image reference for the exact audited linux/amd64
# manifest behind the pinned multi-platform Node image.
WM_NODE_BUILD_CONTEXT=
CLOUDFLARED_VERSION=2026.8.2
CLOUDFLARED_AMD64_SHA256=fcfb02b575a52ca1af2e3267af4e1517bcdeb30ac48c834c69abaed3c0576ad2

REDIS_PASSWORD=replace-with-openssl-rand-hex-32
REDIS_TOKEN=replace-with-openssl-rand-hex-32
WM_SESSION_SECRET=replace-with-openssl-rand-hex-32
WM_AUTH_COOKIE_SECRET=replace-with-openssl-rand-hex-32
RELAY_SHARED_SECRET=replace-with-openssl-rand-hex-32

SEED_INTERVAL_SECONDS=1800
INITIAL_SEED_DELAY_SECONDS=20
SEED_TIMEOUT=1800
MARKET_YAHOO_REFRESH_INTERVAL_MS=900000

# Optional providers. Empty values are allowed; dependent features will be
# absent or degraded and must not be represented as verified data coverage.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
GROQ_API_KEY=
OPENROUTER_API_KEY=
AISSTREAM_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
EIA_API_KEY=
FRED_API_KEY=
ACLED_EMAIL=
ACLED_PASSWORD=
ACLED_ACCESS_TOKEN=
UCDP_ACCESS_TOKEN=
NASA_FIRMS_API_KEY=
CLOUDFLARE_API_TOKEN=
AVIATIONSTACK_API=
TRAVELPAYOUTS_API_TOKEN=
OPENAQ_API_KEY=
WAQI_API_KEY=
